# Copy this file to .env (which is gitignored) and fill in the values.
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env

# Required. Your Groq API key, from https://console.groq.com/keys (starts with "gsk_").
GROQ_API_KEY=

# Optional. Your own email address(es), comma-separated. Only used when importing
# sample_emails.json (from explore.rb), to recognise mail you sent yourself.
# Synced mail uses Gmail's SENT label instead, so you can leave this empty.
MY_EMAIL_ADDRESSES=
