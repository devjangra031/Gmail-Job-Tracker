<% content_for :title, "Review queue" %>

<h1 class="mb-1 text-2xl font-semibold">Review queue</h1>
<p class="mb-6 text-sm text-slate-500">
  Emails the classifier wasn't sure about. They don't count anywhere until you confirm them.
  <%= pluralize(@remaining, "email") %> left.
</p>

<% if @email.nil? %>
  <p class="rounded-lg border border-slate-200 bg-white p-8 text-center text-slate-500">Nothing to review. 🎉</p>
<% else %>
  <div class="grid gap-6 lg:grid-cols-5">
    <article class="rounded-lg border border-slate-200 bg-white p-5 lg:col-span-3">
      <h2 class="font-semibold"><%= @email.subject.presence || "(no subject)" %></h2>
      <p class="mb-4 text-sm text-slate-500"><%= @email.from_address %> · <%= long_time(@email.sent_at) %></p>
      <pre class="max-h-[28rem] overflow-y-auto whitespace-pre-wrap text-sm"><%= @email.body.presence || @email.raw_snippet %></pre>
    </article>

    <%= form_with url: review_path(@email), method: :patch, class: "space-y-4 rounded-lg border border-slate-200 bg-white p-5 text-sm lg:col-span-2" do |f| %>
      <div class="rounded-md bg-amber-50 px-3 py-2 text-amber-900">
        Classifier guessed <strong><%= @email.category ? kind_label(@email.category) : "nothing usable" %></strong>
        <%= "(#{(@email.confidence.to_f * 100).round}% sure)" if @email.category %>
        <div class="text-xs"><%= @email.classifier_reason %></div>
      </div>

      <label class="block">
        <span class="mb-1 block font-medium">Company</span>
        <%= text_field_tag :company, @email.extracted_company, class: "w-full rounded-md border-slate-300 px-2 py-1.5" %>
      </label>
      <label class="block">
        <span class="mb-1 block font-medium">Role</span>
        <%= text_field_tag :role, @email.extracted_role, class: "w-full rounded-md border-slate-300 px-2 py-1.5" %>
      </label>

      <div>
        <span class="mb-2 block font-medium">This email is…</span>
        <div class="flex flex-wrap gap-2">
          <% Tracker::EVENT_KINDS.each do |kind| %>
            <%= button_tag kind_label(kind), name: "category", value: kind,
                  class: "rounded-md border px-2.5 py-1 #{kind == @email.category ? 'border-slate-900 bg-slate-900 text-white' : 'border-slate-300 hover:bg-slate-100'}" %>
          <% end %>
        </div>
      </div>

      <div class="flex gap-2 border-t border-slate-100 pt-4">
        <%= button_tag "Job suggestion (not an application)", name: "category", value: "job_alert",
              class: "rounded-md border border-slate-300 px-2.5 py-1 hover:bg-slate-100" %>
        <%= button_tag "Discard as noise", name: "discard", value: "1",
              class: "rounded-md border border-rose-300 px-2.5 py-1 text-rose-700 hover:bg-rose-50" %>
      </div>
    <% end %>
  </div>
<% end %>
