<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Job Tracker" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Job Tracker">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-5 py-3">
        <%= link_to "Job Tracker", root_path, class: "font-semibold" %>
        <%= nav_link "Dashboard", root_path %>
        <%= nav_link "Applications", applications_path %>
        <%= nav_link "Review", reviews_path, badge: Email.review_queue.count %>
        <%= nav_link "Sync", sync_path %>
        <%= link_to "+ Add application", new_application_path,
                    class: "ml-auto rounded-md bg-slate-900 px-3 py-1.5 text-sm text-white hover:bg-slate-700" %>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-8">
      <% if notice %>
        <p class="mb-6 rounded-md border border-emerald-200 bg-emerald-50 px-4 py-2 text-sm text-emerald-800"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-6 rounded-md border border-rose-200 bg-rose-50 px-4 py-2 text-sm text-rose-800"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
