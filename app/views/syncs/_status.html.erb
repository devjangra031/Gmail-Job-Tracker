<%# Also rendered by Tracker::Sync broadcasts (no session there, so the form relies on
    Turbo sending the page's CSRF meta token instead of an embedded one). %>
<% running = run&.running? %>
<% default_from = Date.current - Tracker.config[:default_sync_days] %>
<div id="sync_status" class="rounded-lg border border-slate-200 bg-white p-5 text-sm">
  <%= form_with url: sync_path, method: :post, authenticity_token: false, class: "flex flex-wrap items-end gap-3" do |f| %>
    <label class="flex flex-col gap-1">
      <span class="text-xs text-slate-500">From</span>
      <%= f.date_field :date_from, value: (running ? run.date_from : default_from), max: Date.current,
                       disabled: running, class: "rounded-md border-slate-300 px-2 py-1" %>
    </label>
    <label class="flex flex-col gap-1">
      <span class="text-xs text-slate-500">To</span>
      <%= f.date_field :date_to, value: (running ? run.date_to : Date.current), max: Date.current,
                       disabled: running, class: "rounded-md border-slate-300 px-2 py-1" %>
    </label>
    <%= f.submit running ? "Syncing…" : "Sync new mail", disabled: running,
                 class: "rounded-md bg-slate-900 px-4 py-1.5 text-white hover:bg-slate-700 disabled:cursor-not-allowed disabled:bg-slate-400" %>
    <span class="text-xs text-slate-500">Default: last <%= Tracker.config[:default_sync_days] %> days</span>
  <% end %>

  <% if run %>
    <div class="mt-5 border-t border-slate-100 pt-4">
      <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
        <span class="font-medium">
          <% if running %>
            <%= run.phase == "fetching" ? "Fetching new mail from Gmail…" : "Classifying…" %>
          <% elsif run.state == "done" %>
            Last sync finished <%= long_time(run.finished_at) %>
          <% else %>
            Last sync stopped <%= long_time(run.finished_at) %>
          <% end %>
        </span>
        <span class="text-xs text-slate-500"><%= run.date_from %> → <%= run.date_to %></span>
      </div>

      <div class="h-2 overflow-hidden rounded-full bg-slate-100">
        <div class="h-full rounded-full transition-all <%= run.state == 'failed' ? 'bg-rose-500' : 'bg-emerald-500' %>"
             style="width: <%= run.progress %>%"></div>
      </div>

      <dl class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-slate-600">
        <div><dt class="inline text-slate-400">Found</dt> <dd class="inline"><%= run.emails_found %></dd></div>
        <div><dt class="inline text-slate-400">New</dt> <dd class="inline"><%= run.emails_fetched %> / <%= run.emails_new %></dd></div>
        <div><dt class="inline text-slate-400">Classified</dt> <dd class="inline"><%= run.emails_classified %> / <%= run.emails_to_classify %></dd></div>
        <div><dt class="inline text-slate-400">Errors</dt> <dd class="inline"><%= run.errors_count %></dd></div>
      </dl>

      <% if run.last_error.present? %>
        <p class="mt-3 rounded-md px-3 py-2 <%= run.state == 'failed' ? 'bg-rose-50 text-rose-800' : 'bg-amber-50 text-amber-900' %>"><%= run.last_error %></p>
      <% end %>
    </div>
  <% end %>
</div>
