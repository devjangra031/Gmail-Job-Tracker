<% content_for :title, "Sync" %>

<h1 class="mb-1 text-2xl font-semibold">Sync from Gmail</h1>
<p class="mb-6 text-sm text-slate-500">
  Fetches <strong>new</strong> mail from Gmail for the dates you pick, then classifies it.
  This is different from the filters on the Applications page, which only filter what's already been synced.
  Emails already fetched are skipped, so re-syncing a range costs nothing extra.
</p>

<section class="mb-6 flex flex-wrap items-center gap-4 rounded-lg border border-slate-200 bg-white p-4 text-sm">
  <% case @gmail_status %>
  <% when :connected %>
    <span class="text-emerald-700">● Gmail connected (read-only)</span>
  <% when :no_client_file %>
    <span class="text-rose-700">● credentials.json is missing from the project folder.</span>
  <% else %>
    <span class="text-rose-700">
      ● <%= @gmail_status == :expired ? "Gmail access expired (Google expires it after ~7 days while the app is in Testing mode)." : "Gmail is not connected." %>
    </span>
  <% end %>
  <% unless @gmail_status == :no_client_file %>
    <%= button_to (@gmail_status == :connected ? "Reconnect" : "Reconnect Gmail"), gmail_connection_path,
          form: { data: { turbo: false } },
          class: "rounded-md px-3 py-1.5 #{@gmail_status == :connected ? 'border border-slate-300 text-slate-700 hover:bg-slate-100' : 'bg-rose-600 text-white hover:bg-rose-500'}" %>
  <% end %>
</section>

<%= turbo_stream_from Tracker::Sync::STREAM %>
<%= render "syncs/status", run: @run %>

<h2 class="mt-10 mb-2 text-sm font-semibold uppercase tracking-wide text-slate-500">Recent syncs</h2>
<div class="overflow-x-auto rounded-lg border border-slate-200 bg-white">
  <table class="min-w-full text-sm">
    <thead class="bg-slate-100 text-left text-xs uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-2">Started</th><th class="px-4 py-2">Range</th><th class="px-4 py-2">State</th>
        <th class="px-4 py-2 text-right">Found</th><th class="px-4 py-2 text-right">New</th>
        <th class="px-4 py-2 text-right">Classified</th><th class="px-4 py-2 text-right">Errors</th>
        <th class="px-4 py-2">Message</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @runs.each do |run| %>
        <tr>
          <td class="px-4 py-2 whitespace-nowrap"><%= long_time(run.started_at) %></td>
          <td class="px-4 py-2 whitespace-nowrap"><%= run.date_from %> → <%= run.date_to %></td>
          <td class="px-4 py-2"><%= run.state %></td>
          <td class="px-4 py-2 text-right"><%= run.emails_found %></td>
          <td class="px-4 py-2 text-right"><%= run.emails_new %></td>
          <td class="px-4 py-2 text-right"><%= run.emails_classified %></td>
          <td class="px-4 py-2 text-right"><%= run.errors_count %></td>
          <td class="px-4 py-2 text-xs text-slate-500"><%= run.last_error %></td>
        </tr>
      <% end %>
      <% if @runs.empty? %>
        <tr><td colspan="8" class="px-4 py-6 text-center text-slate-500">No syncs yet.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
